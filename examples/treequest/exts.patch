index 0000000..8f9eb97
--- /dev/null
+++ b/tests/test_exts.py
@@ -0,0 +1,116 @@
+import random
+from typing import Optional, Tuple
+
+from treequest.algos.exts import ExTS, ExTSState
+
+
+def test_basic_initialization():
+    """ExTS constructs with sensible defaults and an empty root-only state."""
+    algo = ExTS()
+    # PUCT is the default exploration schedule with C = 1.0.
+    assert algo.exploration_type == "puct"
+    assert algo.exploration_constant == 1.0
+
+    # UCT default constant differs.
+    algo_uct = ExTS(exploration_type="uct")
+    assert algo_uct.exploration_constant == 1.414
+
+    state = algo.init_tree()
+    assert isinstance(state, ExTSState)
+    assert state.tree is not None
+    assert state.tree.root is not None
+    assert state.tree.root.is_root()
+    assert len(state.tree.get_state_score_pairs()) == 0
+
+
+def test_single_step():
+    """A single step expands the root once."""
+    def generate_fn(state: Optional[str]) -> Tuple[str, float]:
+        return f"Generated: {random.random()}", 0.5
+
+    algo = ExTS(seed=42)
+    state = algo.init_tree()
+
+    new_state = algo.step(state, {"generate": generate_fn})
+
+    assert len(new_state.tree.get_state_score_pairs()) == 1
+    assert len(new_state.tree.root.children) == 1
+    child = new_state.tree.root.children[0]
+    assert child.parent is new_state.tree.root
+    assert isinstance(child.state, str)
+    assert "Generated" in child.state
+
+
+def test_multiple_steps_grows_tree():
+    """Running several steps produces one new node per step."""
+    def generate_fn(state: Optional[str]) -> Tuple[str, float]:
+        return f"State: {random.random()}", random.uniform(0.1, 1.0)
+
+    algo = ExTS(seed=0)
+    state = algo.init_tree()
+
+    n_steps = 8
+    for _ in range(n_steps):
+        state = algo.step(state, {"generate": generate_fn})
+
+    assert len(state.tree.get_state_score_pairs()) == n_steps
+    # Root should have accumulated visits equal to the number of expansions.
+    assert state.visit_counts.get(-1, 0) == n_steps
+
+
+def test_score_zero_is_failure():
+    """A score of exactly 0.0 is recorded as a failed expansion.
+
+    The node is still added, and visits are incremented along the ancestor
+    chain, but no success is recorded and no reward is stored.
+    """
+    def generate_fn(state: Optional[str]) -> Tuple[str, float]:
+        return "failed", 0.0
+
+    algo = ExTS(seed=1)
+    state = algo.init_tree()
+    state = algo.step(state, {"generate": generate_fn})
+
+    # One node was added.
+    assert len(state.tree.get_state_score_pairs()) == 1
+    child = state.tree.root.children[0]
+
+    # Visits incremented for child and root, but no successes and no rewards.
+    assert state.visit_counts.get(child.expand_idx, 0) == 1
+    assert state.successful_visits.get(child.expand_idx, 0) == 0
+    assert state.reward_histories.get(child.expand_idx, []) == []
+    assert state.visit_counts.get(-1, 0) == 1
+    assert state.successful_visits.get(-1, 0) == 0
+
+
+def test_positive_score_is_success():
+    """A positive score is backpropagated as a success up to the root."""
+    def generate_fn(state: Optional[str]) -> Tuple[str, float]:
+        return "ok", 0.75
+
+    algo = ExTS(seed=2)
+    state = algo.init_tree()
+    state = algo.step(state, {"generate": generate_fn})
+
+    child = state.tree.root.children[0]
+    assert state.successful_visits.get(child.expand_idx, 0) == 1
+    assert state.reward_histories.get(child.expand_idx, []) == [0.75]
+    # Global score bounds updated.
+    assert state.score_min == 0.75
+    assert state.score_max == 0.75
+    # Success propagated to the root as well.
+    assert state.successful_visits.get(-1, 0) == 1
+
+
+def test_stateless_step_does_not_mutate_input():
+    """With inplace=False (default), step returns a new state and leaves the
+    input untouched, matching the stateless Algorithm contract."""
+    def generate_fn(state: Optional[str]) -> Tuple[str, float]:
+        return "x", 0.5
+
+    algo = ExTS(seed=3)
+    state = algo.init_tree()
+    new_state = algo.step(state, {"generate": generate_fn})
+
+    assert len(state.tree.get_state_score_pairs()) == 0
+    assert len(new_state.tree.get_state_score_pairs()) == 1
