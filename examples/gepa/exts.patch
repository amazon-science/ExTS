+# ── ExTS (Exploit More, Explore Smarter for Budget-Constrained Agentic Search) integration ──
+# ExTS attaches to GEPA as a pluggable candidate-selection controller. The tree
+# exposes a small duck-typed interface (initialize_root / select / add_child /
+# backpropagate_success / backpropagate_failure / sync_scores / save) that GEPA
+# calls at fixed hook points below. See gepa/exts.py for the algorithm.
+from .exts import ExTSTree
+
+
+def rebuild_exts_tree_from_gepa_state(tree: ExTSTree, gepa_state) -> None:
+    """Rebuild an ExTS tree from an existing GEPAState (e.g. checkpoint resume).
+
+    Reconnects every previously discovered program to its parent and seeds one
+    successful visit per node so selection has a warm prior after resuming.
+    """
+    for prog_idx in range(1, len(gepa_state.program_candidates)):
+        parents = gepa_state.parent_program_for_candidate[prog_idx]
+        parent_idx = parents[0] if parents[0] is not None else 0
+        if parent_idx not in tree._nodes:
+            continue
+        score = gepa_state.per_program_tracked_scores[prog_idx]
+        tree.add_child(
+            parent_program_idx=parent_idx,
+            child_program_idx=prog_idx,
+            child_program_score=score,
+        )
+        node = tree.get_node(prog_idx)
+        node.visits = 1
+        node.successful_visits = 1
+        node.reward_history.append(score)
+        tree._score_min = min(tree._score_min, score)
+        tree._score_max = max(tree._score_max, score)
+
+    if tree.root:
+        tree.root.visits = len(gepa_state.program_candidates)
+        tree.root.successful_visits = len(gepa_state.program_candidates)
+
