+"""
+ExTS candidate-selection variant for K-MSE molecular structure elucidation.
+
+This is the *controller pattern*: an ``ExTSTree`` (from ``exts.py``) owns the
+decision of *which candidate to refine next*, while K-MSE keeps ownership of
+*how to generate* (the zero-shot / critique / refine LLM pipeline) and *how to
+score* (the molecule-spectrum neural scorer). The generation and scoring code
+below is identical to the original ``mcts.MCTSrGPT``; only the tree-search
+policy is swapped.
+
+``MCTSrExTS.run`` mirrors ``mcts.MCTSr.run`` step for step, but replaces the
+MCTS-R UCT importance-sampling selection with ``ExTSTree.select``. Because every
+rollout produces a scored child, only ``backpropagate_success`` is used
+(``backpropagate_failure`` / ``sync_scores`` are unnecessary here).
+"""
+
+from __future__ import annotations
+
+import random
+
+import numpy as np
+import tqdm
+from pydantic import BaseModel, PrivateAttr
+from rdkit import Chem
+from rdkit.Chem import rdMolDescriptors
+
+from agent import Agent, smiles_to_image, encode_image
+from models.encoder import Scorer
+from retriever import Retriever
+from exts import ExTSTree
+
+
+def load_prompt(text_file):
+    with open(text_file, 'r') as f:
+        return f.read()
+
+
+def get_formula(smiles):
+    if smiles == '':
+        return None
+    mol = Chem.MolFromSmiles(smiles)
+    if mol is None:
+        return None
+    return rdMolDescriptors.CalcMolFormula(mol)
+
+
+def print_tree_node(node_data, level=0, output_file=None):
+    indent = " " * level * 2
+    line = (
+        f"ExTSNode(idx={node_data['idx']}, smiles={node_data['smiles']}, "
+        f"score={node_data['score']:.2f}, visits={node_data['visits']}, "
+        f"succ={node_data['successful_visits']})"
+    )
+    if output_file:
+        with open(output_file, 'a') as f:
+            print(indent + line, file=f)
+    else:
+        print(indent + line)
+    for child in node_data.get('children', []):
+        print_tree_node(child, level + 1, output_file)
+
+
+class ExTSCandidateNode(BaseModel):
+    """One K-MSE candidate (a single LLM generation) tracked alongside its
+    integer ``program_idx`` in the ExTS tree."""
+    nid: int = 1
+    program_idx: int = 0
+    question: str
+    full_answer: str
+    reflection_prompt: str = ''
+    reflection: str = ''
+    predict_smiles: str
+    predict_formula: str
+    parent_idx: int | None = None
+    children_idx: list[int] = []
+    score: float = 0.0
+    reward_samples: list[float] = []
+    evaluations: list[str] = []
+
+    def __repr__(self):
+        return (
+            f"ExTSCandidateNode(id={self.nid}, idx={self.program_idx}, "
+            f"smiles={self.predict_smiles}, score={self.score:.2f})"
+        )
+
+    class Config:
+        arbitrary_types_allowed = True
+
+
+class MCTSrExTS(BaseModel):
+    """K-MSE structure elucidation driven by ExTS candidate selection.
+
+    A sibling of ``mcts.MCTSrGPT`` that reuses its exact generation/scoring
+    pipeline while delegating selection and back-propagation to an ``ExTSTree``.
+    """
+
+    cnmr_data: str
+    hnmr_data: str
+    ir_figure: str
+    formula: str
+    agent: Agent
+
+    retriever: Retriever = None
+    retrieval: bool = True
+    retrieve_topk: int = 5
+    substructure_list: list[tuple] = []
+
+    max_rollouts: int
+    total_node: int = 1
+    reward_limit: int = 95
+    excess_reward_penalty: int = 5
+
+    # ExTS hyperparameters
+    max_children: int = 3
+    exploration_constant: float = 1.0
+    score_temperature: float = 0.3
+    exploration_type: str = "puct"
+    use_gated_expansion: bool = True
+    random_seed: int = 0
+
+    all_gen_tokens: str = ''
+
+    # Internal state
+    _tree: ExTSTree | None = PrivateAttr(default=None)
+    _nodes: dict[int, ExTSCandidateNode] = PrivateAttr(default_factory=dict)
+
+    class Config:
+        arbitrary_types_allowed = True
+
+    def _init_tree(self):
+        self._tree = ExTSTree(
+            exploration_constant=self.exploration_constant,
+            score_temperature=self.score_temperature,
+            max_children=self.max_children,
+            exploration_type=self.exploration_type,
+            use_gated_expansion=self.use_gated_expansion,
+            rng=random.Random(self.random_seed),
+        )
+        self._nodes = {}
+
+    def zero_shot(self) -> dict:
+        question_prompt = load_prompt('code/prompts/question.txt')
+        extract_prompt = load_prompt('code/prompts/extract_ans.txt')
+        question_prompt = question_prompt.replace(
+            '<###FORMULA>', self.formula
+        ).replace(
+            '<###CNMR-DATA>', self.cnmr_data
+        ).replace(
+            '<###HNMR-DATA>', self.hnmr_data
+        )
+
+        self.substructure_list = self.retriever.query(
+            self.cnmr_data, self.hnmr_data, self.formula
+        )
+        substructure_prompt = load_prompt('code/prompts/substructure.txt')
+        substructure_prompt = substructure_prompt.replace(
+            '<###LIST>', str(self.substructure_list)
+        )
+        question_prompt = question_prompt + '\n' + substructure_prompt
+
+        while True:
+            analysis = self.agent.run(
+                question_prompt, image=[encode_image(self.ir_figure)]
+            )
+            if 'llama' in self.agent.model_name.lower():
+                predict_smiles = self.agent.run(
+                    extract_prompt.replace('<###INPUT>', analysis)
+                )
+            else:
+                extract_agent = Agent(temperature=0.7, top_p=0.7)
+                predict_smiles = extract_agent.run(
+                    extract_prompt.replace('<###INPUT>', analysis)
+                )
+            pred_formula = get_formula(predict_smiles)
+            if pred_formula is not None:
+                self.all_gen_tokens += analysis
+                break
+
+        return {
+            'question': question_prompt,
+            'full_answer': analysis,
+            'predict_formula': pred_formula,
+            'predict_smiles': predict_smiles,
+        }
+
+    def self_refine(self, parent_node: ExTSCandidateNode) -> ExTSCandidateNode:
+        question_prompt = load_prompt('code/prompts/question.txt')
+        question_prompt = question_prompt.replace(
+            '<###FORMULA>', self.formula
+        ).replace(
+            '<###CNMR-DATA>', self.cnmr_data
+        ).replace(
+            '<###HNMR-DATA>', self.hnmr_data
+        )
+        substructure_prompt = load_prompt('code/prompts/substructure.txt')
+        substructure_prompt = substructure_prompt.replace(
+            '<###LIST>', str(self.substructure_list)
+        )
+        question_prompt = question_prompt + '\n' + substructure_prompt
+
+        critique_prompt = load_prompt('code/prompts/critique.txt')
+        critique_prompt = critique_prompt.replace(
+            '<###PROBLEM>', question_prompt
+        ).replace(
+            '<###ANSWER>', parent_node.full_answer
+        ).replace(
+            '<###SMILES>', parent_node.predict_smiles
+        ).replace(
+            '<###pred-FORMULA>', parent_node.predict_formula
+        )
+        critique_prompt = critique_prompt.replace(
+            "The final output of the SMILES of the molecule is required to end with 'The SMILES of the molecule is'.",
+            ''
+        )
+        critique = self.agent.run(
+            critique_prompt,
+            image=[encode_image(self.ir_figure), smiles_to_image(parent_node.predict_smiles)]
+        )
+
+        refine_prompt = load_prompt('code/prompts/refine.txt')
+        refine_prompt = refine_prompt.replace(
+            '<###PROBLEM>', question_prompt
+        ).replace(
+            '<###ANSWER>', parent_node.full_answer
+        ).replace(
+            '<###SMILES>', parent_node.predict_smiles
+        ).replace(
+            '<###pred-FORMULA>', parent_node.predict_formula
+        ).replace(
+            '<###CRITIQUE>', critique
+        )
+
+        extract_prompt = load_prompt('code/prompts/extract_ans.txt')
+        substructure_prompt = load_prompt('code/prompts/substructure.txt')
+        substructure_prompt = substructure_prompt.replace(
+            '<###LIST>', str(self.substructure_list)
+        )
+        refine_prompt = refine_prompt + '\n\n' + substructure_prompt
+
+        while True:
+            analysis = self.agent.run(
+                refine_prompt, image=[encode_image(self.ir_figure)]
+            )
+            if 'llama' in self.agent.model_name.lower():
+                predict_smiles = self.agent.run(
+                    extract_prompt.replace('<###INPUT>', analysis)
+                )
+            else:
+                extract_agent = Agent(temperature=0.7, top_p=0.7)
+                predict_smiles = extract_agent.run(
+                    extract_prompt.replace('<###INPUT>', analysis)
+                )
+            pred_formula = get_formula(predict_smiles)
+            if pred_formula is not None:
+                self.all_gen_tokens += critique + analysis
+                break
+
+        self.total_node += 1
+        child_node = ExTSCandidateNode(
+            nid=self.total_node,
+            program_idx=self.total_node - 1,
+            question=refine_prompt,
+            full_answer=analysis,
+            reflection_prompt=critique_prompt,
+            reflection=critique,
+            predict_smiles=predict_smiles,
+            predict_formula=pred_formula,
+            parent_idx=parent_node.program_idx,
+        )
+        return child_node
+
+    def _evaluate(self, node: ExTSCandidateNode, scorer: Scorer) -> float:
+        score = scorer.calc_score(node.predict_smiles, self.cnmr_data, self.hnmr_data)
+        raw_score = float(score * 100)
+        if raw_score > self.reward_limit:
+            raw_score -= self.excess_reward_penalty
+        node.score = raw_score
+        node.reward_samples.append(raw_score)
+        return raw_score
+
+    def run(self, scorer: Scorer) -> str:
+        self._init_tree()
+
+        # Root: original zero-shot generation, scored and seeded into the tree.
+        root_data = self.zero_shot()
+        root_node = ExTSCandidateNode(
+            nid=1,
+            program_idx=0,
+            question=root_data['question'],
+            full_answer=root_data['full_answer'],
+            predict_smiles=root_data['predict_smiles'],
+            predict_formula=root_data['predict_formula'],
+        )
+        root_score = self._evaluate(root_node, scorer)
+        self._nodes[0] = root_node
+        self._tree.initialize_root(program_idx=0, program_score=root_score)
+        self._tree.backpropagate_success(program_idx=0, raw_score=root_score)
+
+        for _ in tqdm.tqdm(range(self.max_rollouts)):
+            # 1. ExTS selects which candidate to refine next.
+            selected_idx = self._tree.select()
+            parent_node = self._nodes[selected_idx]
+
+            # 2. Original K-MSE critique + refine produces a child.
+            child_node = self.self_refine(parent_node)
+            child_idx = child_node.program_idx
+
+            # 3. Original scorer evaluates it.
+            child_score = self._evaluate(child_node, scorer)
+
+            # 4. Attach + back-propagate into the ExTS tree.
+            self._tree.add_child(
+                parent_program_idx=selected_idx,
+                child_program_idx=child_idx,
+                child_program_score=child_score,
+            )
+            self._tree.backpropagate_success(
+                program_idx=child_idx, raw_score=child_score
+            )
+
+            self._nodes[child_idx] = child_node
+            parent_node.children_idx.append(child_idx)
+
+        return self._get_best_answer()
+
+    def _get_best_answer(self) -> str:
+        best_node = max(self._nodes.values(), key=lambda n: np.mean(n.reward_samples))
+        return best_node.predict_smiles
+
+    def print(self, output_file=None):
+        if output_file is not None:
+            import os
+            if os.path.exists(output_file):
+                os.remove(output_file)
+
+        def _build_tree_data(idx):
+            node = self._nodes[idx]
+            tree_node = self._tree.get_node(idx)
+            return {
+                'idx': idx,
+                'smiles': node.predict_smiles,
+                'score': node.score,
+                'visits': tree_node.visits if tree_node else 0,
+                'successful_visits': tree_node.successful_visits if tree_node else 0,
+                'children': [_build_tree_data(c) for c in node.children_idx],
+            }
+
+        root_data = _build_tree_data(0)
+        print_tree_node(root_data, output_file=output_file)
+
+    def print_detail(self, output_dir):
+        for idx, node in self._nodes.items():
+            with open(output_dir + f'/{node.nid}.txt', 'w') as f:
+                f.write('reflection_prompt##################################################################\n')
+                f.write(node.reflection_prompt)
+                f.write('\n\n\n')
+                f.write('reflection##################################################################\n')
+                f.write(node.reflection)
+                f.write('\n\n\n')
+                f.write('question##################################################################\n')
+                f.write(node.question)
+                f.write('\n\n\n')
+                f.write('full_answer##################################################################\n')
+                f.write(node.full_answer)
+                f.write('\n\n\n')
+                f.write('evaluation##################################################################\n')
+                for evaluation in node.evaluations:
+                    f.write(evaluation)
+                    f.write('\n\n\n')
+                    f.write('##################################################################\n')
